# Fournisseur de chat : "mistral" (défaut) ou "tokenrouter".
# Laissé vide, c'est Mistral — rien n'a été supprimé, il est simplement en
# veille quand cette ligne nomme quelqu'un d'autre. Revenir en arrière =
# effacer cette ligne.
CHAT_PROVIDER=

MISTRAL_API_KEY=your-mistral-api-key-here
# Utilisée uniquement quand CHAT_PROVIDER=tokenrouter (passerelle compatible
# OpenAI ; modèle par défaut z-ai/glm-5.3-free).
TOKENROUTER_API_KEY=

# Facultatif : forcent le modèle / l'URL quel que soit le fournisseur choisi.
# Il existe aussi MISTRAL_MODEL, TOKENROUTER_MODEL, etc. pour ne viser qu'un
# fournisseur à la fois.
CHAT_MODEL=
CHAT_API_URL=

PORT=8123

# Laissés vides, server.js (ancienne app, en local) retombe sur le projet écrit en dur
# dans lib/chat-context.js — c'est-à-dire la base de PRODUCTION — et le
# prévient au démarrage. Renseignez-les pour pointer ailleurs.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Refonte ─────────────────────────────────────────────────
# Backfill (npm run backfill) : lit TOUS les comptes, donc contourne RLS.
# Usage local uniquement — jamais sur Cloudflare, Vercel ni GitHub.
SUPABASE_SERVICE_ROLE_KEY=
# Compte dédié aux tests, dans le projet Supabase de test (jamais la prod) :
# E2E (npm run e2e) et contrôle de la base (npm run check:supabase).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Client navigateur de la refonte (Vite) : URL du projet et clé publishable.
# Publiques par nature — RLS protège les données. En local et en E2E : le
# projet de test (stouchi-test), jamais la production.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Aam Salah v2 (/api/aam, refonte) : clé Gemini, et le projet Supabase lu avec
# le jeton de l'utilisateur. En dev, VITE_SUPABASE_* suffisent ; sur Cloudflare
# Pages, renseigner SUPABASE_URL / SUPABASE_ANON_KEY (preview : stouchi-test). Sans
# elles, /api/aam répond 503 — jamais de repli silencieux sur la production.
# Plusieurs clés possibles, séparées par une virgule (clé1,clé2) : si la première
# n'a plus de quota ou ne marche plus, la suivante prend le relais.
GEMINI_API_KEY=
# Facultatif : la chaîne de modèles (défaut dans lib/aam-salah/index.js).
AAM_MODELS=

# Notifications (Phase 4) : clé publique VAPID, lue par le navigateur pour
# s'abonner au push. Publique par nature. La clé privée VAPID et GEMINI_API_KEY
# de notify-run sont des secrets de la fonction Supabase (supabase secrets
# set …), jamais dans .env ni sur Cloudflare. Le secret du cron vit dans Vault.
VITE_VAPID_PUBLIC_KEY=

# PostHog : analytique et suivi des erreurs (Phase 7). La clé projet est
# publique par nature. Vides en local, en E2E et en CI : rien n'est chargé ni
# envoyé. Côté navigateur : VITE_POSTHOG_* (variables de build Cloudflare Pages).
# Côté /api/aam : POSTHOG_API_KEY et POSTHOG_HOST (variables de la fonction).
# Ne jamais activer POSTHOG_CAPTURE_CONTENT en production : il enverrait le
# texte du chat (spec §8.5).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=
